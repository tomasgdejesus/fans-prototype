{
  "name": "@fans/platform",
  "description": "FANS platform React+Vite frontend and Hono API",
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/nprogress": "9.7.3",
    "@tanstack/react-query": "^5.104.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "4.11.1",
    "i18next": "^26.5.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.1.0",
    "react-router": "^8.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.5",
    "pg": "^8.16.3",
    "nodemailer": "^10.2.1",
    "react-email": "^6.11.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.4",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0",
    "wrangler": "4.147.0",
    "@types/pg": "^8.15.5"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "pnpm run typecheck && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:react": "vitest run --project react-app",
    "test:worker": "vitest run --project worker",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run lint && pnpm run test && pnpm run build && wrangler deploy --dry-run",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config=drizzle.runtime.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.runtime.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:email": "vitest run --config vitest.email.config.ts"
  },
  "type": "module"
}
