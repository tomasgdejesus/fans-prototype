{
  "name": "fans",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @fans/platform run dev",
    "build": "pnpm --filter @fans/platform run build",
    "deploy": "pnpm --filter @fans/platform run deploy",
    "typecheck": "pnpm --filter @fans/platform run typecheck",
    "lint": "pnpm --filter @fans/platform run lint",
    "test": "pnpm --filter @fans/platform run test",
    "test:coverage": "pnpm --filter @fans/platform run test:coverage",
    "check": "pnpm --filter @fans/platform run check",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @fans/platform run db:generate",
    "db:migrate": "pnpm --filter @fans/platform run db:migrate",
    "db:studio": "pnpm --filter @fans/platform run db:studio",
    "test:db": "pnpm --filter @fans/platform run test:db"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@12.3.4"
}
